# Copy to .env (next to docker-compose.yml; compose reads it automatically), edit, then:
#   docker compose up -d --build
# To deploy a new version: git pull && docker compose up -d --build

# Host port the web container (Caddy) is published on, bound to 127.0.0.1 only.
# Point Cloudflare Tunnel or the host's reverse proxy at http://127.0.0.1:<HTTP_PORT>; it terminates TLS.
# Pick one no other service on the server uses (coprompt-revibe's example uses 8080).
HTTP_PORT=8081

# Password prompt for the whole site (HTTP basic auth). The browser asks once for a user name and password.
# Leave SITE_PASSWORD empty to make the site public. After changing it: docker compose up -d
SITE_USER=guest
SITE_PASSWORD=

# Records page: your Discogs user name. The records service syncs it every 6 hours; locally, npm run records.
# Your collection must be public, or add a personal token from discogs.com/settings/developers.
DISCOGS_USER=
DISCOGS_TOKEN=

# Auto-deploy (docker compose --profile autodeploy up -d): GitHub Actions asks the server to pull and rebuild after each push.
# DEPLOY_SECRET: any long random string (e.g. openssl rand -hex 32); the same value goes in the repo's Actions secret DEPLOY_SECRET.
DEPLOY_SECRET=
# Only if the repo is private again: a fine-grained token from github.com/settings/tokens, this repo only, Contents read-only.
GITHUB_TOKEN=
