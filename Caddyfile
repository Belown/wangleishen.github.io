# Serves the built site. Plain HTTP: TLS is terminated in front of it (Cloudflare Tunnel or a host proxy),
# which is why compose publishes it on 127.0.0.1 only.
{
	admin off
	auto_https off
}

:80 {
	encode zstd gzip

	# For the container healthcheck; outside the password.
	handle /healthz {
		respond "ok" 200
	}

	handle {
		# Written at start by docker-entrypoint.sh: a password prompt when SITE_PASSWORD is set, else empty.
		import /etc/caddy/auth.caddy
		root * /srv
		header /assets/* Cache-Control "public, max-age=31536000, immutable"
		# Client-side routes (/photos, /work/…) fall back to index.html.
		try_files {path} /index.html
		file_server
	}
}
