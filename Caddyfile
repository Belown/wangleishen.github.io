# Serves the built site. Plain HTTP: TLS is terminated in front of it (Cloudflare Tunnel or a host proxy),
# which is why compose publishes it on 127.0.0.1 only.
{
	admin off
	auto_https off
}

:80 {
	encode zstd gzip

	# For the container healthcheck; outside the password.
	handle /healthz {
		respond "ok" 200
	}

	# GitHub Actions calls this after a push to main. Outside the site password: it can only make the server check GitHub.
	handle /_deploy {
		reverse_proxy deploy:9000
	}

	handle {
		# Written at start by docker-entrypoint.sh: a password prompt when SITE_PASSWORD is set, else empty.
		import /etc/caddy/auth.caddy
		root * /srv
		header /assets/* Cache-Control "public, max-age=31536000, immutable"
		# Records data changes when the records service syncs; browsers check back each time.
		header /data/* Cache-Control "no-cache"
		# Client-side routes (/photos, /work/…) fall back to index.html. Record data (/data/…) does not:
		# a missing records.json or cover is a plain 404, not the page in its place.
		@app {
			not path /data/*
			not file
		}
		rewrite @app /index.html
		file_server
	}
}
